{
  "name": "project-soccer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build": "npm run typecheck && npm --prefix client run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:network": "node --import tsx tests/network-smoke.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "assets:player": "node scripts/build-player.mjs",
    "format": "prettier --write \"client/src/**/*.{ts,css}\" \"client/*.{html,ts}\" \"server/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/*.mjs\" \"tests/*.{ts,mjs}\" \"*.{json,yaml}\" \"{client,server,packages/game-core}/package.json\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "@colyseus/sdk": "0.18.2",
    "prettier": "3.6.2"
  }
}
