FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS development
RUN npm install --global pnpm@11.19.0
WORKDIR /workspace
ENV CI=true
# Source and dependency volumes are supplied by Compose; no source is baked in.
FROM development AS browser-tests
RUN npx --yes playwright@1.63.0 install --with-deps chromium
